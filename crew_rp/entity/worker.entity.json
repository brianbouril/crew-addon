{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "crew:worker",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/crew_worker" },
      "geometry": { "default": "geometry.crew_worker" },
      "scripts": {
        "scale": "0.45",
        "animate": [
          "look",
          { "walk": "query.modified_move_speed > 0.05 || query.property('crew:anim') == 1" },
          { "mine": "query.property('crew:anim') == 2" }
        ]
      },
      "animations": {
        "look": "animation.crew_worker.look",
        "walk": "animation.crew_worker.walk",
        "mine": "animation.crew_worker.mine"
      },
      "render_controllers": ["controller.render.crew_worker"],
      "spawn_egg": { "base_color": "#ff7814", "overlay_color": "#f5c414" }
    }
  }
}
