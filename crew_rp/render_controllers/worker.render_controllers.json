{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.crew_worker": {
      "arrays": {
        "textures": {
          "Array.skins": ["Texture.miner", "Texture.digger", "Texture.woodcutter", "Texture.farmer", "Texture.hauler"]
        }
      },
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["Array.skins[query.property('crew:role')]"],
      "part_visibility": [
        { "*": true },
        { "hat": "query.property('crew:role') != 4" },
        { "cap": "query.property('crew:role') == 4" },
        { "pack": "query.property('crew:role') == 4 && !query.property('crew:loaded')" },
        { "pack_full": "query.property('crew:role') == 4 && query.property('crew:loaded')" }
      ]
    }
  }
}
